# AKSHARA GAMING CENTER - ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env dan isi kredensial riil saat deployment

# 1. Telegram Bot HITL (Human-in-the-loop)
# Buat bot melalui @BotFather di Telegram untuk mendapatkan bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Dapatkan chat id Anda melalui @userinfobot di Telegram
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# 2. Shopee Email Listener (Metode A: IMAP Gmail)
# Gunakan Google App Password (bukan password akun utama Gmail)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=akshara.store.orders@gmail.com
IMAP_APP_PASSWORD=your_16_char_google_app_password

# 3. WhatsApp Gateway (Fonnte / Wablas)
# Untuk dispatch kredensial login otomatis ke nomor WA pembeli
FONNTE_API_TOKEN=your_fonnte_api_token_here
FONNTE_API_URL=https://api.fonnte.com/send

# 4. Financial & Margin Defaults
DEFAULT_USD_IDR_RATE=16350.0
DEFAULT_CARD_FX_FEE_PCT=2.0
DEFAULT_SHOPEE_ADMIN_FEE_PCT=8.0
DEFAULT_SHOPEE_FIXED_FEE_IDR=1000.0
DEFAULT_PACKAGING_COST_IDR=2000.0
DEFAULT_TARGET_NET_MARGIN_PCT=25.0
